BAREMETAL_ADAPTER_DB_PASSWORD=replace-with-a-generated-password
BAREMETAL_ADAPTER_STORAGE_HOST=/srv/baremetal-adapter/storage
BAREMETAL_ADAPTER_STORAGE_READ_ONLY=false
BAREMETAL_ADAPTER_NAME=Bare-Metal Adapter
BAREMETAL_ADAPTER_DB_URL=postgresql+psycopg://baremetal:${BAREMETAL_ADAPTER_DB_PASSWORD}@postgres:5432/baremetal
BAREMETAL_ADAPTER_REDIS_URL=redis://redis:6379/0
BAREMETAL_ADAPTER_STORAGE_ROOT=/storage
BAREMETAL_ADAPTER_SCRATCH_ROOT=/scratch
BAREMETAL_ADAPTER_SCRATCH_LIMIT_GIB=20
BAREMETAL_ADAPTER_MIN_FREE_GIB=10
BAREMETAL_ADAPTER_ADMIN_USER=admin
BAREMETAL_ADAPTER_ADMIN_PASSWORD=change-me
